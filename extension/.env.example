# Copy to .env:  cp .env.example .env
# Only variables starting with WXT_ are exposed to extension code.

# Base URL of the MailCraft backend (no trailing slash)
WXT_API_URL=http://localhost:3000

# Google Cloud OAuth client ID (type: "Chrome Extension"). Used for Gmail
# sign-in via chrome.identity. Not secret: it ships in the manifest.
# Google Cloud Console → APIs & Services → Credentials
WXT_GOOGLE_CLIENT_ID=YOUR_CLIENT_ID.apps.googleusercontent.com
