generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model achievement {
  id             BigInt @id @default(autoincrement())
  name           String @unique
  description    String
  icon           String
  criteria_type  String
  criteria_value String
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model userStats {
  xp               Int
  level            Int      @default(1) @db.SmallInt
  highest_level    Int      @db.SmallInt
  current_streak   Int      @db.SmallInt
  longest_streak   Int      @db.SmallInt
  last_active_date DateTime @default(dbgenerated("CURRENT_DATE")) @db.Date
  best_day_count   Int      @db.SmallInt
  best_day_date    DateTime @default(dbgenerated("CURRENT_DATE")) @db.Date
  user_id          BigInt   @id
  users            users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model users {
  id            BigInt         @id @default(autoincrement())
  created_at    DateTime       @default(now()) @db.Timestamp(6)
  email         String?        @unique
  username      String         @unique
  password_hash String
  timezone      String
  pointHistory  PointHistory[]
  friendships   Friendship[]   @relation("Friendship_user")
  friendOf      Friendship[]   @relation("Friendship_friend")
  userStats     userStats?
}

model PointHistory {
  id         BigInt   @id @default(autoincrement())
  user_id    BigInt
  amount     Int
  action     String
  created_at DateTime @default(now()) @db.Timestamp(6)
  users      users    @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

/// Friends list. Each friendship is stored as two rows, (A, B) and (B, A).
/// Created by prisma/sql/2026-11-11_add_friendship.sql
/// This table has a check constraint (user_id <> friend_id) that Prisma doesn't model.
model Friendship {
  user_id    BigInt
  friend_id  BigInt
  created_at DateTime @default(now()) @db.Timestamp(6)
  user       users    @relation("Friendship_user", fields: [user_id], references: [id], onDelete: Cascade)
  friend     users    @relation("Friendship_friend", fields: [friend_id], references: [id], onDelete: Cascade)

  @@id([user_id, friend_id])
  @@index([friend_id])
}
