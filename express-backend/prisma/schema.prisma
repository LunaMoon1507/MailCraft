generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model achievement {
  id             BigInt @id @default(autoincrement())
  name           String @unique
  description    String
  icon           String
  criteria_type  String
  criteria_value String
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model userStats {
  xp               Int      @db.SmallInt
  level            Int      @default(1) @db.SmallInt
  highest_level    Int      @db.SmallInt
  current_streak   Int      @db.SmallInt
  longest_streak   Int      @db.SmallInt
  last_active_date DateTime @default(dbgenerated("CURRENT_DATE")) @db.Date
  best_day_count   Int      @db.SmallInt
  best_day_date    DateTime @default(dbgenerated("CURRENT_DATE")) @db.Date
  user_id          BigInt   @id
  users            users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model users {
  id            BigInt     @id @default(autoincrement())
  created_at    DateTime   @default(now()) @db.Timestamp(6)
  email         String     @unique
  username      String     @unique
  password_hash String
  timezone      String
  userStats     userStats?
}
